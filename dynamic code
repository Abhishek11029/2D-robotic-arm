function dx = robotDynamics(t,x,m1,m2,l1,l2,g,...
                            Kp,Kd,Ki,theta_ref)

%% STATES
theta = x(1:2);
dtheta = x(3:4);

% Integral states
int_e = x(5:6);

%% ERROR
e = theta_ref - theta;

de = -dtheta;

%% MIMO PID
f = Kp*e + Kd*de + Ki*int_e;

%% JOINT ANGLES
q1 = theta(1);
q2 = theta(2);

dq1 = dtheta(1);
dq2 = dtheta(2);

%% INERTIA MATRIX M(theta)

M11 = (m1+m2)*l1^2 ...
      + m2*l2^2 ...
      + 2*m2*l1*l2*cos(q2);

M12 = m2*l2^2 ...
      + m2*l1*l2*cos(q2);

M21 = M12;

M22 = m2*l2^2;

M = [M11 M12;
     M21 M22];

%% CORIOLIS / CENTRIFUGAL TERMS

h = m2*l1*l2*sin(q2);

C1 = -h*(2*dq1*dq2 + dq2^2);

C2 = h*dq1^2;

C = [C1;
     C2];

%% GRAVITY

G1 = (m1+m2)*g*l1*cos(q1) ...
     + m2*g*l2*cos(q1+q2);

G2 = m2*g*l2*cos(q1+q2);

G = [G1;
     G2];

%% TORQUE
% Decoupled PID input -> physical motor torques
tau = M*f + C + G;

%% ROBOT ACCELERATION
ddtheta = M \ (tau - C - G);

%% STATE DERIVATIVE
dx = zeros(6,1);

dx(1:2) = dtheta;
dx(3:4) = ddtheta;

% Integral error
dx(5:6) = e;

end
